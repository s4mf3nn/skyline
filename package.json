{
  "name": "skyline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm gen && expo start --port $PORT",
    "gen": "node scripts/gen-features.mjs",
    "typecheck": "pnpm gen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "pnpm gen && vitest run",
    "test:coverage": "pnpm gen && vitest run --coverage",
    "test:holdout": "pnpm gen && node scripts/holdout.mjs run",
    "test:contract": "node scripts/contract-files.mjs run",
    "verify": "pnpm gen && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:render && pnpm test:contract && node scripts/check-contract.mjs",
    "verify:quiet": "node scripts/verify-quiet.mjs",
    "tokens": "node scripts/token-report.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "progress": "node scripts/progress-table.mjs",
    "prepare": "lefthook install || true",
    "test:native": "jest --json --outputFile=$CONTRACT_REPORT",
    "test:render": "jest --passWithNoTests src",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@react-native/jest-preset": "0.86.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eas-cli": "24.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lefthook": "^2.1.15",
    "tailwindcss": "^3.4",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@sentry/react-native": "~7.11.0",
    "expo": "57.0.28",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.26",
    "expo-updates": "~57.0.26",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "main": "expo-router/entry",
  "factory": {
    "routeDirs": [
      "app"
    ],
    "routeIgnore": [
      "_layout.tsx",
      "+*"
    ],
    "contractRunners": {
      "native": "test:native"
    }
  }
}
